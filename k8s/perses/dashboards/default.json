            }
          ]
        }
      }
    ],
    "panels": {
      "8767b5cdec4747e9b76f30236c98c23f": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Container Memory %"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "table",
                "position": "right",
                "size": "small",
                "values": [
                  "last",
                  "max"
                ]
              },
              "yAxis": {
                "format": {
                  "unit": "percent"
                },
                "label": "",
                "show": true
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum by (k8s.pod.name, k8s.container.name) (100 * {__name__=\"k8s.container.memory_limit_utilization\", k8s.container.name=~\"$containers\"})",
                    "seriesNameFormat": "{{k8s.pod.name}}: {{k8s.container.name}}"
                  }
                }
              }
            }
          ]
        }
      },
      "a233da967ff241408162e8f75881c829": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Container Memory usage"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "table",
                "position": "right",
                "size": "small",
                "values": [
                  "last",
                  "max"
                ]
              },
              "visual": {
                "areaOpacity": 0.3,
                "connectNulls": false,
                "display": "line",
                "lineStyle": "solid",
                "lineWidth": 1,
                "pointRadius": 2.5,
                "stack": "all"
              },
              "yAxis": {
                "format": {
                  "unit": "decbytes"
                },
                "label": "usage",
                "show": true
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum by (k8s.pod.name, k8s.container.name) ({__name__=\"container.memory.working_set\", k8s.container.name=~\"$containers\"})",
                    "seriesNameFormat": "{{k8s.pod.name}}: {{k8s.container.name}}"
                  }
                }
              }
            }
          ]
        }
      },
      "bbaa26b433aa401891e689b5e6007f67": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "PVC %"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "table",
                "position": "right",
                "size": "small",
                "values": [
                  "last",
                  "max"
                ]
              },
              "yAxis": {
                "format": {
                  "unit": "percent"
                },
                "label": "",
                "show": true
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "100 * (1 - (\n  max by (service.name, k8s.volume.name) ({__name__=\"k8s.volume.available\", k8s.volume.name=~\"home|storage|server-volume\"})\n  /\n  max by (service.name, k8s.volume.name) ({__name__=\"k8s.volume.capacity\", k8s.volume.name=~\"home|storage|server-volume\"})\n))",
                    "seriesNameFormat": "{{service.name}}: {{k8s.volume.name}}"
                  }
                }
              }
            }
          ]
        }
      },
      "c4a5f6d8b3e14a2c9f0d1e2a3b4c5d6e": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Docker Disk Usage (20GB cap)"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "table",
                "position": "right",
                "size": "small",
                "values": [
                  "last",
                  "max"
                ]
              },
              "querySettings": [],
              "visual": {
                "areaOpacity": 0.3,
                "connectNulls": false,
                "display": "line",
                "lineStyle": "solid",
                "lineWidth": 1,
                "pointRadius": 2.5,
                "stack": "all"
              },
              "yAxis": {
                "format": {
                  "unit": "decbytes"
                },
                "label": "usage",
                "max": 20000000000,
                "show": true
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "{__name__=\"docker_disk_usage_bytes\"}",
                    "seriesNameFormat": "{{type}}"
                  }
                }
              }
            }
          ]
        }
      },
      "d1850588f54947dea396d8089348a780": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "PVC usage"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "table",
                "position": "right",
                "size": "small",
                "values": [
                  "last",
                  "max"
                ]
              },
              "visual": {
                "areaOpacity": 0.3,
                "connectNulls": false,
                "display": "line",
                "lineStyle": "solid",
                "lineWidth": 1.25,
                "pointRadius": 2.75,
                "stack": "all"
              },
              "yAxis": {
                "format": {
                  "unit": "decbytes"
                },
                "label": "usage",
                "show": true
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "max by (service.name, k8s.volume.name) ({__name__=\"k8s.volume.capacity\", k8s.volume.name=~\"home|storage|server-volume\"})\n- max by (service.name, k8s.volume.name) ({__name__=\"k8s.volume.available\", k8s.volume.name=~\"home|storage|server-volume\"})",
                    "seriesNameFormat": "{{service.name}}: {{k8s.volume.name}}"
                  }
                }
              }
            }
          ]
        }
      },
      "e8155cd770c6422ebc6a1eeaf38e7fc6": {
        "kind": "Panel",
        "spec": {
          "display": {},
          "plugin": {
            "kind": "LogsTable",
            "spec": {
              "allowWrap": true,
              "enableDetails": true,
              "showTime": true
            }
          },
          "queries": [
            {
              "kind": "LogQuery",
              "spec": {
                "plugin": {
                  "kind": "VictoriaLogsLogQuery",
                  "spec": {
                    "datasource": {
                      "kind": "VictoriaLogsDatasource",
                      "name": "victorialogs"
                    },
                    "query": "*"
                  }
                }
              }
            }
          ]
        }
      },
      "f1a2b3c4d5e647f8a9b0c1d2e3f4a5b6": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Docker Disk Usage (reclaimable)"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "table",
                "position": "right",
                "size": "small",
                "values": [
                  "last",
                  "max"
                ]
              },
              "visual": {
                "areaOpacity": 0.3,
                "connectNulls": false,
                "display": "line",
                "lineStyle": "solid",
                "lineWidth": 1,
                "pointRadius": 2.5,
                "stack": "all"
              },
              "yAxis": {
                "format": {
                  "unit": "decbytes"
                },
                "label": "reclaimable",
                "show": true
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "{__name__=\"docker_disk_usage_reclaimable_bytes\"}",
                    "seriesNameFormat": "{{type}}"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "refreshInterval": "0s",
    "variables": [
      {
        "kind": "ListVariable",
        "spec": {
          "allowAllValue": true,
          "allowMultiple": true,
          "customAllValue": ".*",
          "defaultValue": "$__all",
          "display": {
            "description": "Filter which containers show in the Memory panels",
            "hidden": false,
            "name": "Containers"
          },
          "name": "containers",
          "plugin": {
            "kind": "StaticListVariable",
            "spec": {
              "values": [
                "claude-code",
                "dockerd",
                "myapp",
                "opentelemetry-collector",
                "operator",
                "perses",
                "perses-provisioning-sidecar",
                "cloudflared",
                "tailscale",
                "vlogs",
                "vmsingle"
              ]
            }
          }
        }
      }
    ]
  }
}
