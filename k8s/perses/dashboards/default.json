              "width": 12,
              "height": 6,
              "content": {
                "$ref": "#/spec/panels/a233da967ff241408162e8f75881c829"
              }
            }
          ]
        }
      }
    ],
    "duration": "1h",
    "refreshInterval": "0s"
  }
}
