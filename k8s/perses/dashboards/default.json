{
  "kind": "Dashboard",
  "metadata": {
    "name": "default",
    "createdAt": "2026-07-26T05:40:43.336500064Z",
    "updatedAt": "2026-07-26T08:03:46.621734456Z",
    "version": 7,
    "project": "k3s"
  },
  "spec": {
    "display": {
      "name": "default"
    },
    "panels": {
      "8767b5cdec4747e9b76f30236c98c23f": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Container Memory %"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "list",
                "position": "bottom"
              },
              "yAxis": {
                "format": {
                  "unit": "percent"
                },
                "label": "",
                "show": true
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "100 * {__name__=\"k8s.container.memory_limit_utilization\", k8s.container.name=~\"claude-code|dockerd|myapp|opentelemetry-collector|operator|perses|perses-provisioning-sidecar|cloudflared|tailscale|vlogs|vmsingle\"}",
                    "seriesNameFormat": "{{k8s.pod.name}}: {{k8s.container.name}}"
                  }
                }
              }
            }
          ]
        }
      },
      "a233da967ff241408162e8f75881c829": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Container Memory usage"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "list",
                "position": "bottom"
              },
              "visual": {
                "areaOpacity": 0.3,
                "connectNulls": false,
                "display": "line",
                "lineStyle": "solid",
                "lineWidth": 1.25,
                "pointRadius": 2.75,
                "stack": "all"
              },
              "yAxis": {
                "format": {
                  "unit": "decbytes"
                },
                "label": "usage",
                "show": true
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "{__name__=\"container.memory.working_set\", k8s.container.name=~\"claude-code|dockerd|myapp|opentelemetry-collector|operator|perses|perses-provisioning-sidecar|cloudflared|tailscale|vlogs|vmsingle\"}",
                    "seriesNameFormat": "{{k8s.pod.name}}: {{k8s.container.name}}"
                  }
                }
              }
            }
          ]
        }
      },
      "bbaa26b433aa401891e689b5e6007f67": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "PVC %"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "list",
                "position": "bottom"
              },
              "yAxis": {
                "format": {
                  "unit": "percent"
                },
                "label": "",
                "show": true
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "100 * (1 - (\n  {__name__=\"k8s.volume.available\", k8s.volume.name=~\"home|storage|server-volume\"}\n  /\n  {__name__=\"k8s.volume.capacity\", k8s.volume.name=~\"home|storage|server-volume\"}\n))",
                    "seriesNameFormat": "{{k8s.pod.name}}: {{k8s.volume.name}}"
                  }
                }
              }
            }
          ]
        }
      },
      "d1850588f54947dea396d8089348a780": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "PVC usage"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "list",
                "position": "bottom"
              },
              "visual": {
                "areaOpacity": 0.3,
                "connectNulls": false,
                "display": "line",
                "lineStyle": "solid",
                "lineWidth": 1.25,
                "pointRadius": 2.75,
                "stack": "all"
              },
              "yAxis": {
                "format": {
                  "unit": "decbytes"
                },
                "label": "usage",
                "show": true
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "{__name__=\"k8s.volume.capacity\", k8s.volume.name=~\"home|storage|server-volume\"}\n- {__name__=\"k8s.volume.available\", k8s.volume.name=~\"home|storage|server-volume\"}",
                    "seriesNameFormat": "{{k8s.pod.name}}: {{k8s.volume.name}}"
                  }
                }
              }
            }
          ]
        }
      },
      "e8155cd770c6422ebc6a1eeaf38e7fc6": {
        "kind": "Panel",
        "spec": {
          "display": {},
          "plugin": {
            "kind": "LogsTable",
            "spec": {
              "allowWrap": true,
              "enableDetails": true,
              "showTime": true
            }
          },
          "queries": [
            {
              "kind": "LogQuery",
              "spec": {
                "plugin": {
                  "kind": "VictoriaLogsLogQuery",
                  "spec": {
                    "datasource": {
                      "kind": "VictoriaLogsDatasource",
                      "name": "victorialogs"
                    },
                    "query": "*"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "layouts": [
      {
        "kind": "Grid",
        "spec": {
          "display": {
            "title": "Log",
            "collapse": {
              "open": true
            }
          },
          "items": [
            {
              "x": 0,
              "y": 0,
              "width": 24,
              "height": 6,
              "content": {
                "$ref": "#/spec/panels/e8155cd770c6422ebc6a1eeaf38e7fc6"
              }
            }
          ]
        }
      },
      {
        "kind": "Grid",
        "spec": {
          "display": {
            "title": "PVC",
            "collapse": {
              "open": true
            }
          },
          "items": [
            {
              "x": 0,
              "y": 0,
              "width": 12,
              "height": 6,
              "content": {
                "$ref": "#/spec/panels/bbaa26b433aa401891e689b5e6007f67"
              }
            },
            {
              "x": 12,
              "y": 0,
              "width": 12,
              "height": 6,
              "content": {
                "$ref": "#/spec/panels/d1850588f54947dea396d8089348a780"
              }
            }
          ]
        }
      },
      {
        "kind": "Grid",
        "spec": {
          "display": {
            "title": "Memory",
            "collapse": {
              "open": true
            }
          },
          "items": [
            {
              "x": 0,
