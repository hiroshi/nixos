      {
        "kind": "Grid",
        "spec": {
          "display": {
            "collapse": {
              "open": true
            },
            "title": "Log"
          },
          "items": [
            {
              "content": {
                "$ref": "#/spec/panels/e8155cd770c6422ebc6a1eeaf38e7fc6"
              },
              "height": 6,
              "width": 24,
              "x": 0,
