<%#
  Every resource a tenant needs, in one stream for `kubectl apply -f -`.
  Rendered by TenantProvisioner; locals: namespace, tenant_name, image,
  capacity, storage_size, supervisor_source, api_server_ip.

  Deleting a tenant deletes the namespace, which garbage-collects all of this
  (including the PVC and its TopoLVM logical volume), so nothing here needs its
  own cleanup path.
-%>
apiVersion: v1
kind: Namespace
metadata:
  name: <%= namespace %>
  labels:
    app.kubernetes.io/managed-by: tenant-portal
    tenant-portal/tenant: <%= tenant_name %>
    # The tenant's ServiceAccount holds `edit` in here, which includes creating
    # pods -- without Pod Security Admission that would be enough to run a
    # privileged pod and break out of the namespace (hiroshi/nixos#8). The
    # claude-code container below is written to satisfy `restricted`.
    pod-security.kubernetes.io/enforce: restricted
    pod-security.kubernetes.io/enforce-version: latest
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: claude-code
  namespace: <%= namespace %>
---
# A RoleBinding (not ClusterRoleBinding) to the built-in `edit` ClusterRole:
# full read/write on ordinary workloads, but only inside this one namespace, and
# the rule list stays in sync with upstream as new resource types are aggregated
# into `edit`.
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: claude-code-edit
  namespace: <%= namespace %>
subjects:
  - kind: ServiceAccount
    name: claude-code
    namespace: <%= namespace %>
roleRef:
  kind: ClusterRole
  name: edit
  apiGroup: rbac.authorization.k8s.io
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: claude-code-home
  namespace: <%= namespace %>
spec:
  storageClassName: topolvm-provisioner
  accessModes:
    - ReadWriteOnce
  resources:
    requests:
      storage: <%= storage_size %>
---
# The supervisor ships as a ConfigMap rather than baked into the claude-code
# image so iterating on the bootstrap flow doesn't need an image rebuild/push.
apiVersion: v1
kind: ConfigMap
metadata:
  name: tenant-agent
  namespace: <%= namespace %>
data:
  supervisor.py: |
<%= supervisor_source.each_line.map { |line| "    #{line}" }.join %>
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: claude-code
  namespace: <%= namespace %>
spec:
  replicas: 1
  # RWO PVC on a single node: a RollingUpdate surge would deadlock waiting for
  # the old pod to release the volume.
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: claude-code
  template:
    metadata:
      labels:
        app: claude-code
    spec:
      serviceAccountName: claude-code
      securityContext:
        fsGroup: 1000
        runAsUser: 1000
        runAsGroup: 1000
        runAsNonRoot: true
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: claude-code
          image: <%= image %>
          # The image's ENTRYPOINT is claude itself; the supervisor takes over
          # as PID 1 and drives claude through a pty instead.
          command: ["/usr/bin/python3", "/opt/tenant-agent/supervisor.py"]
          ports:
            - containerPort: 8080
          env:
            - name: PORT
              value: "8080"
            - name: CLAUDE_CAPACITY
              value: "<%= capacity %>"
            - name: TZ
              value: Asia/Tokyo
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop: ["ALL"]
          # Interactive claude plus remote-control is a real Node.js process,
          # not a thin CLI: a 128Mi-class limit OOMKills it seconds after the
          # session connects.
          resources:
            requests:
              memory: 1Gi
            limits:
              memory: 2Gi
          readinessProbe:
            httpGet:
              path: /status
              port: 8080
            initialDelaySeconds: 2
            periodSeconds: 5
          volumeMounts:
            - name: home
              mountPath: /home/claude
            - name: tenant-agent
              mountPath: /opt/tenant-agent
              readOnly: true
      volumes:
        - name: home
          persistentVolumeClaim:
            claimName: claude-code-home
        - name: tenant-agent
          configMap:
            name: tenant-agent
---
apiVersion: v1
kind: Service
metadata:
  name: claude-code
  namespace: <%= namespace %>
spec:
  type: ClusterIP
  selector:
    app: claude-code
  ports:
    - port: 8080
      targetPort: 8080
---
# Network isolation: nothing may reach the claude-code pod except the portal
# (on 8080, the supervisor's API -- see README "Known gaps") and other pods in
# the tenant's own namespace, and the pod may only reach other pods in its own
# namespace, CoreDNS, the Kubernetes API server, and the outside world -- never
# another tenant's pod/Service, and never the LAN or Tailscale tailnet this
# node sits on (confirmed reachable otherwise: private address space is not
# inherently a Kubernetes-internal range, so a plain "everything but pod/
# service CIDR" rule would have exposed every other device on the network, and
# every other Tailscale-exposed service, to every tenant -- see the `except`
# list below).
#
# The Kubernetes API server has no backing pod in k3s (its Endpoints point at
# the control-plane node's real IP:6443, confirmed via `kubectl get endpoints
# kubernetes`), so it can't be targeted by a podSelector, and an ipBlock
# naming its ClusterIP (10.43.0.1/32) would not reliably match either --
# traffic to it is NATed to the node's real address before this policy's
# egress check runs. It gets its own narrow ipBlock rule below instead, built
# from `api_server_ip` -- TenantProvisioner#manifests reads that same
# Endpoints object live at render time (KubernetesClient#get("Endpoints",
# "kubernetes", namespace: "default")) rather than it being hardcoded here.
# kubectl ships in the claude-code image (see k8s/claude-code/flake.nix) and
# the tenant's `edit` RoleBinding above is useless over the network without
# this.
#
# This is discovered rather than hardcoded because a single-node k3s cluster
# has no more stable handle on "the API server" to give egress to, and because
# committing the node's real address to this template's git history is
# exactly what this design avoids. If the node's address ever changes,
# re-running `provision!` against an existing tenant (Server-Side Apply makes
# that idempotent) picks up the new one.
#
# k3s's bundled NetworkPolicy controller (kube-router) has a documented history
# of not reliably exempting kubelet-sourced readiness/liveness probe traffic
# from ingress policies, since it arrives from the node's own IP rather than
# through a Service or pod IP. If claude-code's readinessProbe stops passing
# once this is applied, see README "Known gaps" for the workaround.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: namespace-isolation
  namespace: <%= namespace %>
spec:
  podSelector: {}
  policyTypes:
    - Ingress
    - Egress
  ingress:
    # A podSelector with no namespaceSelector matches pods in this policy's
    # own namespace -- the tenant's `edit` role lets it run more than the one
    # claude-code pod, and those pods need to reach each other.
    - from:
        - podSelector: {}
    - from:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: default
          podSelector:
            matchLabels:
              app: tenant-portal
      ports:
        - protocol: TCP
          port: 8080
  egress:
    - to:
        - podSelector: {}
    - to:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: kube-system
          podSelector:
            matchLabels:
              k8s-app: kube-dns
      ports:
        - protocol: UDP
          port: 53
        - protocol: TCP
          port: 53
    - to:
        - ipBlock:
            cidr: <%= api_server_ip %>/32   # discovered at provision time; see comment above
      ports:
        - protocol: TCP
          port: 6443
    - to:
        - ipBlock:
            cidr: 0.0.0.0/0
            except:
              # Standard private/reserved address space, not a description of
              # this cluster's actual layout -- deliberately broader than
              # what's in use here so nothing about the network's real
              # topology has to be committed or kept in sync with this file.
              - 10.0.0.0/8       # RFC1918 (covers the pod CIDR 10.42.0.0/16 and Service CIDR 10.43.0.0/16)
              - 172.16.0.0/12    # RFC1918
              - 192.168.0.0/16   # RFC1918 (covers the node's LAN)
              - 100.64.0.0/10    # CGNAT / Tailscale tailnet range
              - 169.254.0.0/16   # link-local
